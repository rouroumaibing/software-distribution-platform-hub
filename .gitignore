# ===== 构建产物（生成物，应清理） =====
bin/
*.exe
*.test
*.out
coverage/
*.err.txt
*_err.txt

# ===== swaggo 生成的 API 文档（可由 `swag init` 重新生成） =====
docs/docs.go
docs/swagger.json
docs/swagger.yaml

# ===== 本地环境变量（含密钥，勿提交） =====
.env
.env.*
!.env.example

# ===== 本地服务运行时（pid/日志，勿提交） =====
.run/

# ===== 打包输出（build/hub/build.sh 生成） =====
output/

# ===== 系统 / 编辑器 =====
.DS_Store
.idea/
.vscode/
*.swp
