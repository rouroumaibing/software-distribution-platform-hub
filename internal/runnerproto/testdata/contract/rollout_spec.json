{
  "workloadRef": "app",
  "stableImage": "app:stable",
  "canaryImage": "app:canary",
  "steps": [
    {
      "setWeight": 25,
      "pause": {
        "duration": "30s"
      }
    },
    {
      "setWeight": 100
    }
  ],
  "healthCheck": {
    "type": "HTTPProbe",
    "httpPath": "/healthz"
  },
  "trafficRouting": {
    "type": "IngressCanary",
    "ingressRef": "app-ingress"
  }
}